  "zones": [
    {
      "desc": "北通鷗尾漁港的高地碎石坡，山風捲著野生苦艾草香。",
      "id": "oi:cell4695:skirt_a",
      "name": "風語橋哨・外郊苦艾警戒坡",
      "y0": 0,
      "y1": 1360
    },
    {
      "desc": "四戶巡城衛兵與石工家庭圍繞石板小廣場而居，屋內石灶飄著熱麥湯香。",
      "id": "oi:burg_4695:hamlet",
      "name": "風語橋哨・哨所聚落院落",
      "y0": 1360,
      "y1": 3180
    },
    {
      "desc": "橫跨南境溪流的青石橋釘著雙層檢疫木柵，四座銅火盆日夜焚燒苦艾煙查驗封條。",
      "id": "oi:burg_4695:yard",
      "name": "風語橋哨・檢疫石橋哨柵",
      "y0": 3180,
      "y1": 4040
    },
    {
      "desc": "幹道旁立著風化青石界碑，待檢糧車停靠路側，南接幽深松橡林徑。",
      "id": "oi:cell4695:0",
      "name": "風語橋哨・檢疫橋頭與界石林徑",
      "y0": 4040,
      "y1": 5120
    }
