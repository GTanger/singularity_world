#!/usr/bin/env bash
# 奇點世界 — Rust 版一鍵啟動：閘門 → 建置 → 啟動。
# 用法：在專案根目錄執行 ./start-rust
# 對齊 Go 版 ./start 的流程，替換為 Rust 工具鏈。

set -e
cd "$(dirname "$0")"
SW_DIR="$(pwd)"
CHATMERY_DIR="${CHATMERY_DIR:-$SW_DIR/../chatmery}"

PORT=1721

# 1) 先殺佔用 1721 的 process
if command -v lsof &>/dev/null; then
  pids=$(lsof -ti :$PORT 2>/dev/null) || true
  if [[ -n "$pids" ]]; then
    echo "結束佔用 :$PORT 的 process：$pids"
    kill $pids 2>/dev/null || true
    sleep 1
  fi
elif command -v fuser &>/dev/null; then
  if fuser ${PORT}/tcp &>/dev/null; then
    echo "結束佔用 :$PORT 的 process…"
    fuser -k ${PORT}/tcp 2>/dev/null || true
    sleep 1
  fi
fi
pkill -x chatmery-web 2>/dev/null || true
sleep 1

# 2) 嚴格閘門（Rust 版：clippy → test → checkrooms）
echo "cargo clippy -D warnings…"
cargo clippy -- -D warnings
echo "cargo test…"
cargo test
echo "檢查房間 JSON（checkrooms -brackets -strict）…"
cargo run --bin checkrooms -- -brackets -strict

# 3) 建置奇點（Rust release）
echo "建置奇點（Rust release）…"
cargo build --release
# 偵測 cargo target 目錄（支援自訂 CARGO_TARGET_DIR）
CARGO_OUT="${CARGO_TARGET_DIR:-target}/release/singularity_world"
if [[ ! -f "$CARGO_OUT" ]]; then
  # 嘗試常見自訂路徑
  for candidate in "$HOME/target_ram/release/singularity_world" "target/release/singularity_world"; do
    if [[ -f "$candidate" ]]; then CARGO_OUT="$candidate"; break; fi
  done
fi
mkdir -p bin
cp "$CARGO_OUT" bin/server-rust

# 4) 建置並啟動 Chatmery Web（若目錄存在）
if [[ -d "$CHATMERY_DIR" ]]; then
  echo "建置 Chatmery Web…"
  ( cd "$CHATMERY_DIR" && go build -o chatmery-web ./cmd/chatmery-web )
  echo "啟動 Chatmery Web（:1722）…"
  (
    cd "$CHATMERY_DIR"
    if [[ -f .env ]]; then
      set -a
      source .env 2>/dev/null || true
      set +a
    fi
    nohup env CHATMERY_WEB_PORT=1722 ./chatmery-web >> chatmery-web.log 2>&1
  ) &
  sleep 0.5
fi

# 5) 專案根 .env
if [[ -f "$SW_DIR/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$SW_DIR/.env"
  set +a
fi

# 6) 啟動奇點（Rust，後台）
echo "啟動奇點 Rust（PORT=$PORT）…"
nohup env PORT=$PORT ./bin/server-rust >> sw.log 2>&1 &
sleep 2
echo "已啟動，可關閉終端。奇點 log：$SW_DIR/sw.log"
