        "name_rule": "否+屬+動+補",
        "power_mult": 3.2
      }
    ]
  },
  "naming_formula": {
    "description": "從句中按 name_rule 抽取核心字，重組為技能名",
    "examples": [
      {
        "sentence": "銳·斬·弧",
        "template": "屬+動+構",
        "name_rule": "屬+動",
        "result": "銳斬"
      },
      {
        "sentence": "吾·堅·盾·體·癒",
        "template": "主+屬+動+受+態",
        "name_rule": "屬+動+受",
        "result": "堅盾體"
      },
      {
        "sentence": "傷·吾·者·反·遭·自·傷",
        "template": "動+主+受+否+態+主+動",
        "name_rule": "動×2+否+態",
        "result": "反傷自遭"
      }
    ]
  },
  "value_formula": {
    "description": "技能數值 = 詞元品質均值 × 句長倍率 × 語義加權",
    "quality_weight": "每顆詞元的充能% (0~100) 取均值",
    "length_multiplier": {
      "三字": 1.0,
      "五字": 2.0,
      "七字": 3.5
    },
    "semantic_bonus": {
      "玄": "不加數值，改擲骰參數",
      "否": "反轉效果方向（攻→反擊、護→反彈）",
      "態": "附加持續效果（燃=DOT、凍=減速）"
    }
  }
}