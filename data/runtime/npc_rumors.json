    {
      "id": "seed|2957523|9",
      "text": "加了福的肉質蔬果到貨了，今天特別新鮮",
      "source": "event_seed",
      "source_score": 2,
      "weight": 3,
      "mention_count": 2,
      "last_used_at": 1774514886,
