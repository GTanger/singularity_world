  "chosen_architecture": "C",
  "architecture_options": [
    {
      "id": "A",
      "label": "把活動文案與隨機行為打散",
      "verdict": "rejected",
      "reason": "只能製造表面多樣；重啟後沒有同一意圖，行動也無法倒查依據與後果。"
    },
    {
      "id": "B",
      "label": "照搬 Usurper Reborn 的完整 NPC dispatcher",
      "verdict": "rejected",
      "reason": "可參考能力鏈，但其內容、C# 架構、NPC 專用分派器與模擬尺度不能直接成為白塔世界骨架。"
    },
    {
      "id": "C",
      "label": "人物連續狀態加事件到期推進與共同行動收據",
      "verdict": "selected",
      "reason": "每個人物保留同一身分與未完意圖；離場後按 next_wake_at 推進，玩家與居民使用相同世界動作，所有結果可由正式資料回讀。"
    }
  ],
