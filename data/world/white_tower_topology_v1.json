  ],
  "nodes": [
    {"id":"white_tower_peninsula","name":"白塔半島","display_name":"白塔半島","kind":"world_region","parent_ref":null,"summary":"西出海，中生活，東臨山海，南陷沼關，北仰神山。"},

    {"id":"wt-n-sacred-mountain","name":"神山","display_name":"白塔","kind":"mountain_landmark","parent_ref":"white_tower_peninsula","summary":"青脊山北端頭嶺與半島最高地標，不是建築；地圖稱白塔，當地人稱神山。"},
    {"id":"wt-n-sacred-mountain-peaks","name":"神山主峰群","display_name":"白塔群峰","kind":"mountain_system","parent_ref":"wt-n-sacred-mountain","summary":"主峰常年積雪，向下依序為裸岩坡、碎石帶與雲霧林。"},
    {"id":"wt-n-sacred-mountain-west-long-valley","name":"神山西麓長谷","display_name":"白塔西谷","kind":"valley","parent_ref":"wt-n-sacred-mountain","summary":"主峰與西北低山間的南北長谷，包含高地湖、季節濕地與串聯水道。"},
    {"id":"wt-n-north-crown-sea","name":"北冕海","display_name":"北冕海","kind":"sea","parent_ref":"white_tower_peninsula","summary":"白塔半島北側海域，與神山及北岸共同形成北端山海壓力。"},
    {"id":"wt-n-north-crown-rock-coast","name":"北冕海岩岸","display_name":"北冕岩岸","kind":"coast","parent_ref":"white_tower_peninsula","summary":"岩岬、小海灣、河口與短石灘交錯，只有較大河口附近形成平地。"},

    {"id":"wt-w-windship-island","name":"風舶嶼","display_name":"風舶嶼","kind":"island","parent_ref":"white_tower_peninsula","summary":"天然港灣道西側港島，承接過路修整、補給、等候與轉運。"},
    {"id":"wt-w-windship-island-ridge","name":"風舶嶼山脊","display_name":"風舶嶺","kind":"island_ridge","parent_ref":"wt-w-windship-island","summary":"狹長岩島中央的連續低山脊；西側海崖，東側有小灣、階地與可用岸線。"},
    {"id":"wt-w-natural-harbor-channel","name":"天然港灣道","display_name":"天然港灣道","kind":"marine_channel","parent_ref":"white_tower_peninsula","summary":"風舶嶼與風舶角之間的天然港灣地形與海事北上主通道。"},
    {"id":"wt-w-harbor-channel-north","name":"天然港灣道北口","display_name":"港灣道北口","kind":"channel_segment","parent_ref":"wt-w-natural-harbor-channel","summary":"較寬且較深，直接承受北冕海風浪。"},
    {"id":"wt-w-harbor-channel-middle","name":"天然港灣道中段","display_name":"港灣道狹門","kind":"channel_segment","parent_ref":"wt-w-natural-harbor-channel","summary":"全道最窄且水流最快，船隻交會與轉向最受限制。"},
    {"id":"wt-w-harbor-channel-south","name":"天然港灣道南段","display_name":"港灣道南灣","kind":"channel_segment","parent_ref":"wt-w-natural-harbor-channel","summary":"重新展寬，岸邊出現沙洲、泥灘與平靜泊水區。"},
    {"id":"wt-w-windship-cape","name":"風舶角","display_name":"風舶角","kind":"port_city_anchor","parent_ref":"white_tower_peninsula","summary":"天然港灣道東側港口城市，是海事與內陸人貨消息的主要交接面。"},
    {"id":"wt-w-windship-cape-terrace","name":"風舶角海岸台地","display_name":"風舶台地","kind":"coastal_terrace","parent_ref":"wt-w-windship-cape","summary":"低岸港灣平地向東抬升為穩定台地，再接內陸低丘。"},

    {"id":"wt-c-wenyao","name":"文曜","display_name":"文曜","kind":"city_anchor","parent_ref":"white_tower_peninsula","summary":"中部三河匯流附近的生活、知識、紀錄與跨區轉接大節點。"},
    {"id":"wt-c-wenyao-confluence","name":"文曜三河匯流地","display_name":"文曜三河口","kind":"river_confluence","parent_ref":"wt-c-wenyao","summary":"文曜位於兩河之間較高古河階，三河在周圍會合後向南。"},
    {"id":"wt-c-north-source-river","name":"中部三河北來源","display_name":"北源河","kind":"river","parent_ref":"white_tower_peninsula","summary":"來自神山西南源谷的中部大河；北源河是顯示用結構名，不是已定案河名。"},
    {"id":"wt-c-west-source-river","name":"中部三河西來源","display_name":"西源河","kind":"river","parent_ref":"white_tower_peninsula","summary":"收集西北丘陵與森林水系的中部大河；西源河是顯示用結構名，不是已定案河名。"},
    {"id":"wt-c-east-source-river","name":"中部三河東來源","display_name":"東源河","kind":"river","parent_ref":"white_tower_peninsula","summary":"來自青脊山西麓谷地的中部大河；東源河是顯示用結構名，不是已定案河名。"},
    {"id":"wt-c-central-lower-river","name":"中部下游大河","display_name":"南流河","kind":"river","parent_ref":"white_tower_peninsula","summary":"三河匯流後向南流入水尾澤的半島中部最大河流；南流河是顯示用結構名，不是已定案河名。"},

    {"id":"wt-c-southwest-plain","name":"大圳頭","display_name":"大圳頭","kind":"plain_system","parent_ref":"white_tower_peninsula","summary":"由穩定高河階、沖積平原、舊河道與南緣濕地構成的廣大生活面。"},
    {"id":"wt-c-southwest-high-terrace","name":"大圳頭乾燥高河階","display_name":"西南上原","kind":"river_terrace","parent_ref":"wt-c-southwest-plain","summary":"位於大圳頭北部與西部，地面相對穩定。"},
    {"id":"wt-c-southwest-alluvial","name":"大圳頭沖積平原","display_name":"西南河原","kind":"alluvial_plain","parent_ref":"wt-c-southwest-plain","summary":"靠中央河流，包含支流、堤岸與舊河道。"},
    {"id":"wt-c-southwest-wet-edge","name":"大圳頭南緣濕地","display_name":"西南澤緣","kind":"wetland_edge","parent_ref":"wt-c-southwest-plain","summary":"接近水尾澤，分布牛軛湖、季節積水地與濕林。"},
    {"id":"wt-c-sacred-tower","name":"雲腰雪林","display_name":"雲腰雪林","kind":"city_anchor","parent_ref":"white_tower_peninsula","summary":"文曜東北方、低丘與青脊山西麓之間的自由修行與生活大節點。"},
    {"id":"wt-c-sacred-tower-hill-plain","name":"白塔丘原","display_name":"白塔丘原","kind":"hill_plain","parent_ref":"wt-c-sacred-tower","summary":"由林脊、淺谷、泉水與石質丘陵組成，向東逐漸抬升進入青脊山。"},

    {"id":"wt-e-green-ridge","name":"青脊山","display_name":"青脊山","kind":"mountain_range","parent_ref":"white_tower_peninsula","summary":"半島東側單一主脊，北端為神山，東側直接臨東海。"},
    {"id":"wt-e-green-ridge-west-valleys","name":"青脊山西谷群","display_name":"青脊西谷","kind":"valley_system","parent_ref":"wt-e-green-ridge","summary":"多條向西開口的長谷，各有溪流、沖積扇與谷底，谷間由支脈分隔。"},
    {"id":"wt-e-green-ridge-east-coast","name":"青脊山東海蝕岸","display_name":"青脊東岸","kind":"erosional_coast","parent_ref":"wt-e-green-ridge","summary":"山體直接落海，以海崖、岩岬、崩塌坡與狹窄石灘為主，岸段不連續。"},
    {"id":"wt-e-east-sea","name":"東海","display_name":"東海","kind":"sea","parent_ref":"white_tower_peninsula","summary":"持續沖刷青脊山東側的海域，不形成平順可開發海岸帶。"},

    {"id":"wt-s-black-marsh","name":"水尾澤","display_name":"水尾澤","kind":"wetland_forest_system","parent_ref":"white_tower_peninsula","summary":"中央大河在此失去單一河槽，形成潮濕森林、林澤、淺湖、泥炭地與深沼。"},
    {"id":"wt-s-black-marsh-north-wet-forest","name":"水尾澤北部潮濕森林","display_name":"水尾北林","kind":"wet_forest","parent_ref":"wt-s-black-marsh","summary":"中央大河進入後開始分裂為多條漫流水道，仍以潮濕森林為主。"},
    {"id":"wt-s-black-marsh-central-fen","name":"水尾澤中部林澤","display_name":"水尾林澤","kind":"forest_fen","parent_ref":"wt-s-black-marsh","summary":"林澤、淺湖與泥炭地混合的中段。"},
    {"id":"wt-s-black-marsh-south-network","name":"水尾澤南部深沼水網","display_name":"水尾南澤","kind":"deep_marsh_network","parent_ref":"wt-s-black-marsh","summary":"更深且更不穩定的南部沼澤水網。"},
    {"id":"wt-s-south-sentinel","name":"南哨","display_name":"南哨","kind":"city_anchor","parent_ref":"white_tower_peninsula","summary":"水尾澤內最後一片長期穩定高地上的南向準備與回報節點。"},
    {"id":"wt-s-south-sentinel-dryland","name":"南哨穩定乾地","display_name":"南哨高地","kind":"stable_high_ground","parent_ref":"wt-s-south-sentinel","summary":"不是漂在沼澤中央；南面開始進入會淹沒、改道的水網。"},
    {"id":"wt-s-qinglong-pass","name":"青籠關","display_name":"青籠關","kind":"topographic_pass","parent_ref":"white_tower_peninsula","summary":"狹長高地與山麓通道收束出的南向出口，不預設為城牆關卡。"}
  ],
